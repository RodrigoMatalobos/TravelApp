rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function isActiveMember() {
      return signedIn()
        && exists(memberPath(request.auth.uid))
        && get(memberPath(request.auth.uid)).data.enabled == true;
    }

    function isAdmin() {
      return isActiveMember()
        && get(memberPath(request.auth.uid)).data.role == 'admin';
    }

    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /accessRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && resource.data.status == 'pending'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /countries/{countryId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();

      match /{document=**} {
        allow read: if isActiveMember();
        allow write: if isAdmin();
      }
    }

    match /routeStops/{stopId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    match /valija/{itemId} {
      allow read, write: if isActiveMember();
    }

    match /compras/{itemId} {
      allow read, write: if isActiveMember();
    }

    match /gastos/{itemId} {
      allow read, write: if isActiveMember();
    }
  }
}